{
  "name": "exp-lorer",
  "version": "0.1.0",
  "builtin-baseline": "04a9d8e5212d01ee1dd9478eadd9caade4f8b0d4",
  "dependencies": [
    {
      "name": "qtbase",
      "features": ["widgets", "sql"]
    },
    "qtdeclarative",
    "qtmultimedia",
    "sqlite3",
    "ffmpeg",
    "spdlog",
    "gtest",
    "xxhash",
    "tree-sitter",
    "tree-sitter-c",
    "tree-sitter-cpp",
    "tree-sitter-c-sharp",
    "tree-sitter-python",
    "tree-sitter-javascript",
    "tree-sitter-typescript",
    "tree-sitter-json",
    "tree-sitter-html",
    "tree-sitter-css",
    {
      "name": "libvips",
      "features": ["jpeg", "png", "webp"]
    },
    {
      "name": "libarchive",
      "features": ["bzip2", "lz4", "lzma", "zstd"]
    },
    {
      "name": "pkgconf",
      "host": true
    }
  ]
}
